# =============================================================
# Apex Trust Commercial Bank - Fraud Portal Environment Configuration
# =============================================================

# Application Environment (production / development)
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_postgres_password_here
DB_NAME=bank_fraud_portal

# Database Connection Pool Tuning
DB_POOL_MIN_CACHED=5
DB_POOL_MAX_CACHED=25
DB_POOL_MAX_CONNECTIONS=50

# pgAdmin 4 Connection Credentials
PGADMIN_HOST=localhost
PGADMIN_PORT=5432
PGADMIN_USER=postgres
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_DEFAULT_DATABASE=bank_fraud_portal

# Portal Web Server Configuration
PORTAL_HOST=0.0.0.0
PORTAL_PORT=5050
SERVER_THREADS=16
SERVER_CONNECTION_LIMIT=200

# Security & Governance
# Optional API Key for Process Studio RPA webhooks (leave empty for open local dev)
API_SECRET_KEY=
# SQL Query Console in Web UI (true / false)
ENABLE_SQL_CONSOLE=true

# AutomationEdge (AE) T4 Cloud Server RPA Configuration
AE_SERVER_URL=https://t4.automationedge.com/aeengine
AE_ORG_CODE=your_org_code_here
AE_USERNAME=your_ae_username@example.com
AE_PASSWORD=your_ae_password_here
AE_WORKFLOW_RAISE_FRAUD=WF_RAISE_FRAUD
AE_WORKFLOW_FREEZE_ACCOUNT=BlockBankAccount
AE_WORKFLOW_RESOLVE_TICKET=ResolveFraudTicket
AE_TRIGGER_ENABLED=true

